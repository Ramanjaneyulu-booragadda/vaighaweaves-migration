# VaighaWeaves Next.js — Required Environment Variables
# Copy to .env.local and fill in the values

# Medusa backend URL
MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa publishable key (from Medusa admin → Settings → API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Razorpay publishable key (from Razorpay dashboard → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay secret key — used ONLY in Server Actions, never exposed to client
RAZORPAY_KEY_SECRET=
