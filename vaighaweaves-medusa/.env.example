# VaighaWeaves Medusa Backend - Environment Variables

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=9000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Create database: createdb vaighaweaves_medusa
DATABASE_URL=postgresql://username:password@localhost:5432/vaighaweaves_medusa

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_32_character_minimum_jwt_key_here
COOKIE_SECRET=your_cookie_secret_here_32_characters_minimum

# =============================================================================
# CORS (Frontend URLs)
# =============================================================================
# Allow these origins to access the API
ADMIN_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000
STORE_CORS=http://localhost:3000,http://localhost:3001

# =============================================================================
# AWS S3 (Image Storage)
# Same bucket as old system to avoid re-uploading images
# =============================================================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-vaighaweaves-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# CloudFront CDN (optional but recommended)
AWS_CLOUDFRONT_URL=https://d123456abcdef.cloudfront.net

# =============================================================================
# RAZORPAY PAYMENT GATEWAY
# Copy from old .env (vaighaweaves-server/.env)
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Webhook endpoint (Razorpay will send payment events here)
# Update this in Razorpay dashboard: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_URL=https://your-domain.com/hooks/payment/razorpay

# =============================================================================
# REDIS (Optional - for caching & job queues)
# Recommended for production
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SHIPPING PROVIDERS (Phase 4)
# =============================================================================
# BlueDart
# BLUEDART_API_KEY=
# BLUEDART_API_SECRET=

# Delhivery
# DELHIVERY_API_KEY=
# DELHIVERY_API_SECRET=

# DTDC
# DTDC_API_KEY=

# India Post (if using API)
# INDIA_POST_API_KEY=

# =============================================================================
# EMAIL (Optional - for order notifications)
# =============================================================================
# SendGrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=orders@vaighaweaves.com

# =============================================================================
# MONITORING & LOGGING (Production)
# =============================================================================
# Sentry (error tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Datadog (APM)
# DATADOG_API_KEY=

# =============================================================================
# DEVELOPMENT / TESTING
# =============================================================================
# Skip authentication for testing (DO NOT USE IN PRODUCTION!)
# SKIP_AUTH=false

# Log level: error, warn, info, debug
LOG_LEVEL=debug

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env and fill in your values
# 2. NEVER commit .env to Git (it's in .gitignore)
# 3. Use different .env files for dev/staging/production
# 4. Generate secure random values for JWT_SECRET and COOKIE_SECRET
# 5. Same AWS S3 bucket as old system = no image re-upload needed
